POSTGRES_DB=osai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
CONTROL_PLANE_PORT=8000
DASHBOARD_PORT=3000
CONTROL_PLANE_APPROVER=dashboard-operator

# OSAI exposes exactly three logical model profiles. Secrets remain in the
# environment and are never persisted in PostgreSQL or returned to the UI.
OSAI_ENV=development
OSAI_REASONING_PROVIDER=openai_compatible
OSAI_REASONING_MODEL=
OSAI_REASONING_BASE_URL=https://api.openai.com/v1
OSAI_REASONING_API_KEY=
OSAI_EXECUTION_PROVIDER=openai_compatible
OSAI_EXECUTION_MODEL=
OSAI_EXECUTION_BASE_URL=https://api.openai.com/v1
OSAI_EXECUTION_API_KEY=
OSAI_REVIEW_PROVIDER=openai_compatible
OSAI_REVIEW_MODEL=
OSAI_REVIEW_BASE_URL=https://api.openai.com/v1
OSAI_REVIEW_API_KEY=

# Jira sync stays off until explicitly enabled. The control plane creates one
# idempotent Jira issue per OSAI task after a plan has been approved.
OSAI_JIRA_ENABLED=false
OSAI_JIRA_AUTO_CREATE=false
OSAI_JIRA_BASE_URL=https://your-org.atlassian.net
OSAI_JIRA_PROJECT_KEY=
OSAI_JIRA_EMAIL=
OSAI_JIRA_API_TOKEN=
OSAI_JIRA_BEARER_TOKEN=
OSAI_JIRA_READY_LABEL=osai-ready
OSAI_JIRA_ISSUE_TYPE=Task

# Required only when starting the optional execution worker:
# EXECUTION_JIRA_BASE_URL=https://your-org.atlassian.net
# EXECUTION_JIRA_EMAIL=
# EXECUTION_JIRA_API_TOKEN=
# EXECUTION_JIRA_BEARER_TOKEN=
